{
  "name": "river-assault-reimagined",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "android:add": "npx cap add android && node scripts/native-release.mjs android",
    "android:sync": "npm run build && node scripts/native-release.mjs android && npx cap sync android",
    "android:open": "npx cap open android",
    "desktop:init": "npx tauri init",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test": "node --test tests/*.test.cjs",
    "check:phaser": "tsc --noEmit --project tsconfig.phaser.json",
    "lan": "node scripts/lan-server.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "playwright": "1.56.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "express": "4.22.1",
    "peer": "1.0.2",
    "peerjs": "1.5.5",
    "phaser": "^4.2.1"
  },
  "overrides": {
    "express": {
      "qs": "6.16.2"
    }
  }
}
