{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "River Storm",
  "version": "0.1.0",
  "identifier": "com.riverstorm.game",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "River Storm",
        "width": 1000,
        "height": 780,
        "minWidth": 500,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "River Storm - arcade de combate aéreo"
  }
}